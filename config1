-- Animazione rainbow loading text
spawn(function()
	while loadingFrame.Parent do
		loadingGradient.Offset = Vector2.new((tick() % 2) - 1, 0)
		barGradient.Offset = Vector2.new((tick() % 2) - 1, 0)
		wait(0.05)
	end
end)

-- Loading animazione
spawn(function()
	for i = 0, 100, 2 do
		local tween = TweenService:Create(loadingBarFill, TweenInfo.new(0.1), {
			Size = UDim2.new(i / 100, 0, 1, 0)
		})
		tween:Play()
		percentText.Text = i .. "%"
		wait(0.05)
	end
	
	wait(0.5)
	
	-- Fade out loading
	local fadeOut = TweenService:Create(loadingFrame, TweenInfo.new(0.5), {
		BackgroundTransparency = 1
	})
	local textFade = TweenService:Create(loadingText, TweenInfo.new(0.5), {
		TextTransparency = 1
	})
	local barFade = TweenService:Create(loadingBarBg, TweenInfo.new(0.5), {
		BackgroundTransparency = 1
	})
	local fillFade = TweenService:Create(loadingBarFill, TweenInfo.new(0.5), {
		BackgroundTransparency = 1
	})
	local percentFade = TweenService:Create(percentText, TweenInfo.new(0.5), {
		TextTransparency = 1
	})
	
	fadeOut:Play()
	textFade:Play()
	barFade:Play()
	fillFade:Play()
	percentFade:Play()
	
	wait(0.5)
	loadingFrame:Destroy()
	
