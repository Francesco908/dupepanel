	logPadding.PaddingTop = UDim.new(0, 10)
	logPadding.PaddingLeft = UDim.new(0, 10)
	logPadding.Parent = consoleLog

	local logOrder = 0
	local function addLog(text)
		logOrder = logOrder + 1
		local logText = Instance.new("TextLabel")
		logText.Size = UDim2.new(1, -20, 0, 20)
		logText.BackgroundTransparency = 1
		logText.Text = "> " .. text
		logText.TextColor3 = Color3.fromRGB(0, 255, 0)
		logText.TextSize = 14
		logText.Font = Enum.Font.Code
		logText.TextXAlignment = Enum.TextXAlignment.Left
		logText.LayoutOrder = logOrder
		logText.Parent = consoleLog
		consoleLog.CanvasSize = UDim2.new(0, 0, 0, logLayout.AbsoluteContentSize.Y + 20)
		consoleLog.CanvasPosition = Vector2.new(0, consoleLog.CanvasSize.Y.Offset)
	end

	local consoleRunning = false

	startButton.MouseButton1Click:Connect(function()
		if not consoleRunning then
			consoleRunning = true
			startButton.Text = "Running..."
			startButton.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
			addLog("Started")
			
			spawn(function()
				while consoleRunning do
					wait(math.random(2, 5))
					if consoleRunning then
						local choice = math.random(1, 2)
						if choice == 1 then
							local ping = math.random(20, 150)
							addLog("Ping: " .. ping .. "ms")
						else
							local fps = math.random(30, 60)
							addLog("FPS: " .. fps)
						end
					end
				end
			end)
		end
	end)

	-- Close Button Function
	closeButton.MouseButton1Click:Connect(function()
		consoleRunning = false
		local closeTween = TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
			Size = UDim2.new(0, 0, 0, 0)
		})
		closeTween:Play()
		closeTween.Completed:Connect(function()
			screenGui:Destroy()
		end)
	end)

	local function switchTab(tab)
		mainContent.Visible = false
		dupeContent.Visible = false
		consoleContent.Visible = false
		
		tabMain.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
		tabDupe.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
		tabConsole.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
		
		if tab == "Main" then
			mainContent.Visible = true
			tabMain.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
		elseif tab == "Dupe" then
			dupeContent.Visible = true
			tabDupe.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
		elseif tab == "Console" then
			consoleContent.Visible = true
			tabConsole.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
		end
	end

	tabMain.MouseButton1Click:Connect(function() switchTab("Main") end)
	tabDupe.MouseButton1Click:Connect(function() switchTab("Dupe") end)
	tabConsole.MouseButton1Click:Connect(function() switchTab("Console") end)

	-- Pop up animazione
	local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	local frameTween = TweenService:Create(mainFrame, tweenInfo, {
		Size = UDim2.new(0, 550, 0, 320)
	})
	frameTween:Play()
end)
