local function createTab(name, isActive)
	local tab = Instance.new("TextButton")
	tab.Name = "Tab" .. name
	tab.Size = UDim2.new(0, 80, 0, 26)
	tab.BackgroundColor3 = isActive and Color3.fromRGB(45, 45, 60) or Color3.fromRGB(30, 30, 40)
	tab.Text = name
	tab.TextColor3 = isActive and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 150, 160)
	tab.TextSize = 12
	tab.Font = Enum.Font.GothamBold
	tab.AutoButtonColor = false
	tab.Parent = tabContainer

	local tabCorner = Instance.new("UICorner")
	tabCorner.CornerRadius = UDim.new(0, 6)
	tabCorner.Parent = tab

	local tabStroke = Instance.new("UIStroke")
	tabStroke.Color = isActive and Color3.fromRGB(100, 120, 255) or Color3.fromRGB(50, 50, 60)
	tabStroke.Thickness = 1
	tabStroke.Transparency = isActive and 0.3 or 0.7
	tabStroke.Parent = tab

	tab.MouseEnter:Connect(function()
		TweenService:Create(tab, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(50, 50, 65)}):Play()
	end)

	tab.MouseLeave:Connect(function()
		if not tab:GetAttribute("Active") then
			TweenService:Create(tab, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(30, 30, 40)}):Play()
		end
	end)

	return tab, tabStroke
end

