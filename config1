local logOrder = 0
local function addLog(text, logType)
	logOrder = logOrder + 1
	
	local logFrame = Instance.new("Frame")
	logFrame.Size = UDim2.new(1, -6, 0, 20)
	logFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
	logFrame.BorderSizePixel = 0
	logFrame.LayoutOrder = logOrder
	logFrame.Parent = consoleLog

	local logFrameCorner = Instance.new("UICorner")
	logFrameCorner.CornerRadius = UDim.new(0, 5)
	logFrameCorner.Parent = logFrame

	local logText = Instance.new("TextLabel")
	logText.Size = UDim2.new(1, -8, 1, 0)
	logText.Position = UDim2.new(0, 8, 0, 0)
	logText.BackgroundTransparency = 1
	logText.Text = "> " .. text
	logText.TextSize = 11
	logText.Font = Enum.Font.Code
	logText.TextXAlignment = Enum.TextXAlignment.Left
	logText.Parent = logFrame

	if logType == "success" then
		logText.TextColor3 = Color3.fromRGB(80, 250, 150)
	elseif logType == "info" then
		logText.TextColor3 = Color3.fromRGB(100, 180, 255)
	else
		logText.TextColor3 = Color3.fromRGB(180, 180, 190)
	end

	consoleLog.CanvasSize = UDim2.new(0, 0, 0, logLayout.AbsoluteContentSize.Y + 16)
	consoleLog.CanvasPosition = Vector2.new(0, consoleLog.CanvasSize.Y.Offset)
end

local consoleRunning = false

startButton.MouseButton1Click:Connect(function()
	if not consoleRunning then
		consoleRunning = true
		startButton.Text = "Running..."
		startButton.BackgroundColor3 = Color3.fromRGB(80, 80, 90)
		addLog("Console started", "success")
		
		spawn(function()
			while consoleRunning do
				wait(math.random(2, 4))
				if consoleRunning then
					local choice = math.random(1, 2)
					if choice == 1 then
						addLog("Ping: " .. math.random(15, 120) .. "ms", "info")
					else
						addLog("FPS: " .. math.random(45, 60), "info")
					end
				end
			end
		end)
	end
end)

