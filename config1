-- Tab switching
local allTabs = {
	{tab = tabMain, stroke = tabMainStroke, content = mainContent},
	{tab = tabDupe, stroke = tabDupeStroke, content = dupeContent},
	{tab = tabConsole, stroke = tabConsoleStroke, content = consoleContent}
}

local function switchTab(selectedTab)
	for _, tabData in ipairs(allTabs) do
		local isActive = tabData.tab == selectedTab
		tabData.tab:SetAttribute("Active", isActive)
		tabData.content.Visible = isActive
		
		TweenService:Create(tabData.tab, TweenInfo.new(0.2), {
			BackgroundColor3 = isActive and Color3.fromRGB(45, 45, 60) or Color3.fromRGB(30, 30, 40),
			TextColor3 = isActive and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 150, 160)
		}):Play()
		
		TweenService:Create(tabData.stroke, TweenInfo.new(0.2), {
			Color = isActive and Color3.fromRGB(100, 120, 255) or Color3.fromRGB(50, 50, 60),
			Transparency = isActive and 0.3 or 0.7
		}):Play()
	end
end

tabMain.MouseButton1Click:Connect(function() switchTab(tabMain) end)
tabDupe.MouseButton1Click:Connect(function() switchTab(tabDupe) end)
tabConsole.MouseButton1Click:Connect(function() switchTab(tabConsole) end)

